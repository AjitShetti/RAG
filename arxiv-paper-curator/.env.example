# ── Database ──────────────────────────────────────────────────
# Sync URL (psycopg2) — used by Airflow tasks, scripts, and repositories
DATABASE_URL=postgresql://rag_user:rag_password@localhost:5433/rag_db

# Async URL (asyncpg) — used by FastAPI dependency injection
ASYNC_DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5433/rag_db

# ── OpenSearch ────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ── LLM Provider (provider-agnostic) ─────────────────────────
LLM_PROVIDER=console.groq.com
LLM_MODEL=
LLM_API_KEY=sk-...

# ── Redis & Caching ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# ── Langfuse Observability ────────────────────────────────────
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── arXiv Ingestion ───────────────────────────────────────────
ARXIV_MAX_RESULTS=20
ARXIV_RATE_LIMIT_CALLS=3
ARXIV_RATE_LIMIT_PERIOD=1.0
ARXIV_DEFAULT_QUERY=cs.AI

# ── Telegram Bot & Agentic RAG ────────────────────────────────
TELEGRAM_BOT_TOKEN=""
AGENTIC_MAX_REWRITES=2

